Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "       ", 
   RowBox[{
    RowBox[{"Criacao", " ", "2", " ", "pares", " ", "q"}], "-", 
    RowBox[{"qbar", " ", "iguais"}]}], " ", "*)"}], "    ", 
  "\[IndentingNewLine]", 
