   4.0008718389396467`*^9, 4.0008718419417887`*^9}, {4.0009829921204624`*^9, 
   4.0009830330248556`*^9}, {4.0009873773069963`*^9, 4.0009874941130095`*^9}, 
   4.0009884475261145`*^9, {4.0009938562093487`*^9, 4.00099390188652*^9}, {
   4.001833229428305*^9, 4.001833236633286*^9}, {4.0042087911684246`*^9, 
   4.0042087952424173`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"dressingTransformationPotentials", "[", 
   RowBox[{"evals_", ",", "xMax_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[CurlyEpsilon]", ",", "f", ",", "g", ",", 
      RowBox[{"evals1", "=", 
       RowBox[{
        RowBox[{"Sort", "[", "evals", "]"}], "-", 
        RowBox[{"Max", "[", "evals", "]"}]}]}], ",", 
      RowBox[{"W", "=", 
       RowBox[{"0", "&"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CurlyEpsilon]", "=", 
         RowBox[{"evals1", "[", 
          RowBox[{"[", 
           RowBox[{"-", "k"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"W", "=", 
         RowBox[{
          RowBox[{"NDSolveValue", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"f", "'"}], "[", "x", "]"}], "-", 
                RowBox[{
                 RowBox[{"f", "[", "x", "]"}], "^", "2"}], "+", 
                RowBox[{"W", "[", "x", "]"}]}], "\[Equal]", 
               "\[CurlyEpsilon]"}], ",", 
              RowBox[{
               RowBox[{"f", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"g", "'"}], "[", "x", "]"}], "\[Equal]", 
               RowBox[{
                RowBox[{"4", " ", 
                 RowBox[{"f", "[", "x", "]"}], " ", 
                 RowBox[{
                  SuperscriptBox["f", "\[Prime]"], "[", "x", "]"}]}], "-", 
                RowBox[{
                 SuperscriptBox["W", "\[Prime]"], "[", "x", "]"}]}]}], ",", 
              RowBox[{
               RowBox[{"g", "[", "0", "]"}], "\[Equal]", 
               RowBox[{
                RowBox[{"2", " ", "\[CurlyEpsilon]"}], "-", 
                RowBox[{"W", "[", "0", "]"}]}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"f", ",", "g"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "0", ",", "xMax"}], "}"}], ",", "opts"}], 
           "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "2", ",", 
         RowBox[{"Length", "[", "evals1", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Function", "@@", 
      RowBox[{"{", 
       RowBox[{"\[Xi]", ",", 
        RowBox[{
         RowBox[{"W", "[", "\[Xi]", "]"}], "+", 
         RowBox[{"Max", "[", "evals", "]"}]}]}], "}"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9926073059436007`*^9, 3.992607305944605*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Loop varredura acumulando niveis", "Subsubsection",
 CellChangeTimes->{{4.0006292115798674`*^9, 4.000629223874652*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"matout", "=", 
   RowBox[{"OpenWrite", "[", "\"\<ResHEP1.csv\>\"", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{4.0008206264055014`*^9, 4.00082233949637*^9}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"NivCalc", "=", "2"}], ",", 
   RowBox[{"NivCalc", "\[LessEqual]", "NumNiveis"}], ",", 
   RowBox[{"NivCalc", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NivElem", "=", 
     RowBox[{"Take", "[", 
      RowBox[{"Niveis", ",", "NivCalc"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"PotCorte", "=", 
     RowBox[{"Evaluate", "[", 
      RowBox[{"PorcCorte", "*", 
       RowBox[{"Niveis", "[", 
        RowBox[{"[", "NivCalc", "]"}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<==========   Numero de niveis calculados:\>\"", ",", "NivCalc", 
      ",", "\"\<==========\>\""}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"V", "=", 
     RowBox[{"dressingTransformationPotentials", "[", 
      RowBox[{"NivElem", ",", "PotxMax"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"xCorte", "=", "PotxMax"}], ";", "\[IndentingNewLine]", 
    RowBox[{"While", " ", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"xCorte", ">", "0.0"}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{"PotCorte", "<", 
         RowBox[{"V", "[", "xCorte", "]"}]}], ")"}]}], ",", 
      RowBox[{"xCorte", "=", 
       RowBox[{"xCorte", "-", "xstep"}]}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Raio do poco para PotCorte=\>\"", ",", "PotCorte", ",", 
      "\"\< xCorte=\>\"", ",", "xCorte"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"ListaCorte", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"ListaCorte", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"NivElem", "[", 
          RowBox[{"[", "NivCalc", "]"}], "]"}], ",", "xCorte"}], "}"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "\"\<Potencial obtido:\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"V", "[", 
        RowBox[{"Abs", "[", "x", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "xCorte"}], ",", "xCorte"}], "}"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "\"\<Niveis experimentais:\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "NivElem", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"ndse", "=", 
     RowBox[{"NDEigensystem", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"\[Psi]", "''"}], "[", "x", "]"}]}], "+", 
        RowBox[{
         RowBox[{"V", "[", 
          RowBox[{"Abs", "[", "x", "]"}], "]"}], " ", 
         RowBox[{"\[Psi]", "[", "x", "]"}]}]}], ",", "\[Psi]", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "PotxMax"}], ",", "PotxMax"}], "}"}], ",", "NivCalc", 
       ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<SpatialDiscretization\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<FiniteElement\>\"", ",", 
            RowBox[{"{", 
             RowBox[{"\"\<MeshOptions\>\"", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"\"\<MaxCellMeasure\>\"", "\[Rule]", "0.005"}], 
               "}"}]}], "}"}]}], "}"}]}], "}"}]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
    "Print", "[", 
     "\"\<Niveis obtidos pela solucao eq Schrodinger com este potencial:\>\"",
      "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"ndse", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{
    "Print", "[", "\"\<Funcoes de onda obtidas e potencial:\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"V", "[", 
             RowBox[{"Abs", "[", "x", "]"}], "]"}], "/", 
            RowBox[{"Niveis", "[", 
             RowBox[{"[", "NivCalc", "]"}], "]"}]}], ",", " ", 
           RowBox[{"Evaluate", "[", 
            RowBox[{
             RowBox[{"ndse", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "j"}], "]"}], "]"}], "[", "x", "]"}], 
            "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "xCorte"}], ",", "xCorte"}], "}"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "NivCalc"}], "}"}]}], "]"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"WriteString", "[", 
     RowBox[{"matout", ",", "\"\<\\n===== Nivel maximo \>\"", ",", 
      RowBox[{"ToString", "[", 
       RowBox[{"NivCalc", ",", "InputForm"}], "]"}], ",", 
      "\"\< =====; \\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"WriteString", "[", 
     RowBox[{"matout", ",", "\"\<Energia=; \>\"", ",", 
      RowBox[{"ToString", "[", 
       RowBox[{
        RowBox[{"Niveis", "[", 
         RowBox[{"[", "NivCalc", "]"}], "]"}], ",", "InputForm"}], "]"}], 
      ",", "\"\<; \\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"WriteString", "[", 
     RowBox[{"matout", ",", "\"\<xCorte=; \>\"", ",", 
      RowBox[{"ToString", "[", 
       RowBox[{"xCorte", ",", "InputForm"}], "]"}], ",", "\"\<; \\n\\n\>\""}],
      "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"lista", "=", 
     RowBox[{"{", "\"\<x; Pot; \>\"", "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", "NivCalc"}], ",", 
      RowBox[{"i", "++"}], ",", 
      RowBox[{"lista", "=", 
       RowBox[{"Append", "[", 
        RowBox[{"lista", ",", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"\"\<Psi\>\"", ",", 
           RowBox[{"ToString", "[", 
            RowBox[{"i", ",", "InputForm"}], "]"}], ",", "\"\<; \>\""}], 
          "]"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"lista", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"lista", ",", "\"\<\\n\>\""}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Cabec", "=", 
     RowBox[{"StringJoin", "[", "lista", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"WriteString", "[", 
     RowBox[{"matout", ",", "Cabec"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"lista", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"lista", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"lista", ",", 
          RowBox[{"StringJoin", "[", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{"x", ",", "InputForm"}], "]"}], ",", "\"\<; \>\"", ",", 
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"V", "[", 
               RowBox[{"Abs", "[", "x", "]"}], "]"}], ",", "InputForm"}], 
             "]"}], ",", "\"\<; \>\""}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", "NivCalc"}], ",", 
         RowBox[{"i", "++"}], ",", 
         RowBox[{"lista", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"lista", ",", 
            RowBox[{"StringJoin", "[", 
             RowBox[{"StringJoin", "[", 
              RowBox[{
               RowBox[{"ToString", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"ndse", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", "i"}], "]"}], "]"}], "[", "x", "]"}], 
                 ",", "InputForm"}], "]"}], ",", "\"\<; \>\""}], "]"}], 
             "]"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"lista", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"lista", ",", "\"\<\\n\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Cabec", "=", 
        RowBox[{"StringJoin", "[", "lista", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"matout", ",", "Cabec"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "xCorte"}], ",", "xCorte", ",", 
        RowBox[{"xCorte", "/", "NumRegArq"}]}], "}"}]}], "]"}], ";"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  "\"\<==========   Raio da bolha x Energia   ===========\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"ListaCorte", ",", 
   RowBox[{"Joined", "\[Rule]", "True"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WriteString", "[", 
   RowBox[{
   "matout", ",", 
    "\"\<\\n===== Raio da bolha x Energia ===== \\nRaio; Energia; \\n\>\""}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<", "NumNiveis"}], ",", 
    RowBox[{"i", "++"}], ",", 
    RowBox[{"WriteString", "[", 
     RowBox[{"matout", ",", 
      RowBox[{"ToString", "[", 
       RowBox[{
        RowBox[{"ListaCorte", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "InputForm"}], "]"}], 
      ",", "\"\<; \>\"", ",", 
      RowBox[{"ToString", "[", 
       RowBox[{
        RowBox[{"ListaCorte", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", "InputForm"}], "]"}], 
      ",", "\"\<; \\n\>\""}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Close", "[", "matout", "]"}], "\[IndentingNewLine]"}], "Input",
