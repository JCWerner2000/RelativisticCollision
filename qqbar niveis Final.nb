Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "       ", 
   RowBox[{
    RowBox[{"Criacao", " ", "1", " ", "par", " ", "q"}], "-", 
    RowBox[{"qbar", " ", "real"}]}], "   ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Niveis", "=", 
