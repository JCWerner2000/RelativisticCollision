 CellChangeTimes->{{4.0018459814301896`*^9, 4.001845989677358*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"dressingTransformationPotentials", "[", 
   RowBox[{"evals_", ",", "xMax_", ",", "opts___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[CurlyEpsilon]", ",", "f", ",", "g", ",", 
      RowBox[{"evals1", "=", 
       RowBox[{
        RowBox[{"Sort", "[", "evals", "]"}], "-", 
        RowBox[{"Max", "[", "evals", "]"}]}]}], ",", 
      RowBox[{"W", "=", 
       RowBox[{"0", "&"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CurlyEpsilon]", "=", 
         RowBox[{"evals1", "[", 
          RowBox[{"[", 
           RowBox[{"-", "k"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"W", "=", 
         RowBox[{
          RowBox[{"NDSolveValue", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"f", "'"}], "[", "x", "]"}], "-", 
                RowBox[{
                 RowBox[{"f", "[", "x", "]"}], "^", "2"}], "+", 
                RowBox[{"W", "[", "x", "]"}]}], "\[Equal]", 
               "\[CurlyEpsilon]"}], ",", 
              RowBox[{
               RowBox[{"f", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"g", "'"}], "[", "x", "]"}], "\[Equal]", 
               RowBox[{
                RowBox[{"4", " ", 
                 RowBox[{"f", "[", "x", "]"}], " ", 
                 RowBox[{
                  SuperscriptBox["f", "\[Prime]"], "[", "x", "]"}]}], "-", 
                RowBox[{
                 SuperscriptBox["W", "\[Prime]"], "[", "x", "]"}]}]}], ",", 
              RowBox[{
               RowBox[{"g", "[", "0", "]"}], "\[Equal]", 
               RowBox[{
                RowBox[{"2", " ", "\[CurlyEpsilon]"}], "-", 
                RowBox[{"W", "[", "0", "]"}]}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"f", ",", "g"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "0", ",", "xMax"}], "}"}], ",", "opts"}], 
           "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "2", ",", 
         RowBox[{"Length", "[", "evals1", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Function", "@@", 
      RowBox[{"{", 
       RowBox[{"\[Xi]", ",", 
        RowBox[{
         RowBox[{"W", "[", "\[Xi]", "]"}], "+", 
         RowBox[{"Max", "[", "evals", "]"}]}]}], "}"}]}]}]}], 
   "]"}]}]], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Loop varredura dos 5 barions", "Subsubsection",
 CellChangeTimes->{{4.0014143378943815`*^9, 4.0014143578223705`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"matout", "=", 
   RowBox[{"OpenWrite", "[", "\"\<ResHEP1.csv\>\"", "]"}]}], ";"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"NivCalc", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"ii", "=", "1"}], ",", 
   RowBox[{"ii", "\[LessEqual]", 
    RowBox[{"Length", "[", "BarDat", "]"}]}], ",", 
   RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NivElem", "=", 
     RowBox[{"BarDat", "[", 
      RowBox[{"[", "ii", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"PotCorte", "=", 
     RowBox[{"Evaluate", "[", 
      RowBox[{"PorcCorte", "*", 
       RowBox[{"NivElem", "[", 
        RowBox[{"[", "NivCalc", "]"}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<==========   Barion: \>\"", ",", 
      RowBox[{"BarTit", "[", 
       RowBox[{"[", "ii", "]"}], "]"}], ",", "\"\<==========\>\""}], "]"}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"V", "=", 
     RowBox[{"dressingTransformationPotentials", "[", 
      RowBox[{"NivElem", ",", "PotxMax"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"xCorte", "=", "PotxMax"}], ";", "\[IndentingNewLine]", 
    RowBox[{"While", " ", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"xCorte", ">", "0.0"}], ")"}], "&&", 
       RowBox[{"(", 
        RowBox[{"PotCorte", "<", 
         RowBox[{"V", "[", "xCorte", "]"}]}], ")"}]}], ",", 
      RowBox[{"xCorte", "=", 
       RowBox[{"xCorte", "-", "xstep"}]}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Raio do poco para PotCorte=\>\"", ",", "PotCorte", ",", 
      "\"\< xCorte=\>\"", ",", "xCorte"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "\"\<Potencial obtido:\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"V", "[", 
        RowBox[{"Abs", "[", "x", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "xCorte"}], ",", "xCorte"}], "}"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "\"\<Niveis experimentais:\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "NivElem", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"ndse", "=", 
     RowBox[{"NDEigensystem", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"\[Psi]", "''"}], "[", "x", "]"}]}], "+", 
        RowBox[{
         RowBox[{"V", "[", 
          RowBox[{"Abs", "[", "x", "]"}], "]"}], " ", 
         RowBox[{"\[Psi]", "[", "x", "]"}]}]}], ",", "\[Psi]", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "PotxMax"}], ",", "PotxMax"}], "}"}], ",", "NivCalc", 
       ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<SpatialDiscretization\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"\"\<FiniteElement\>\"", ",", 
            RowBox[{"{", 
             RowBox[{"\"\<MeshOptions\>\"", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"\"\<MaxCellMeasure\>\"", "\[Rule]", "0.005"}], 
               "}"}]}], "}"}]}], "}"}]}], "}"}]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
    "Print", "[", 
     "\"\<Niveis obtidos pela solucao eq Schrodinger com este potencial:\>\"",
      "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"ndse", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"WriteString", "[", 
     RowBox[{"matout", ",", "\"\<\\n===== Barion \>\"", ",", 
      RowBox[{"BarTit", "[", 
       RowBox[{"[", "ii", "]"}], "]"}], ",", "\"\< =====; \\n\>\""}], "]"}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"WriteString", "[", 
     RowBox[{"matout", ",", "\"\<Energia=; \>\"", ",", 
      RowBox[{"ToString", "[", 
       RowBox[{
        RowBox[{"BarDat", "[", 
         RowBox[{"[", 
          RowBox[{"ii", ",", "5"}], "]"}], "]"}], ",", "InputForm"}], "]"}], 
      ",", "\"\<; \\n\>\""}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"WriteString", "[", 
     RowBox[{"matout", ",", "\"\<xCorte=; \>\"", ",", 
      RowBox[{"ToString", "[", 
       RowBox[{"xCorte", ",", "InputForm"}], "]"}], ",", "\"\<; \\n\\n\>\""}],
      "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"lista", "=", 
     RowBox[{"{", "\"\<x; Pot; \>\"", "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", "NivCalc"}], ",", 
      RowBox[{"i", "++"}], ",", 
      RowBox[{"lista", "=", 
       RowBox[{"Append", "[", 
        RowBox[{"lista", ",", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"\"\<Psi\>\"", ",", 
           RowBox[{"ToString", "[", 
            RowBox[{"i", ",", "InputForm"}], "]"}], ",", "\"\<; \>\""}], 
          "]"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"lista", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"lista", ",", "\"\<\\n\>\""}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Cabec", "=", 
     RowBox[{"StringJoin", "[", "lista", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"WriteString", "[", 
     RowBox[{"matout", ",", "Cabec"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"lista", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"lista", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"lista", ",", 
          RowBox[{"StringJoin", "[", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{"x", ",", "InputForm"}], "]"}], ",", "\"\<; \>\"", ",", 
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"V", "[", 
               RowBox[{"Abs", "[", "x", "]"}], "]"}], ",", "InputForm"}], 
             "]"}], ",", "\"\<; \>\""}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", "NivCalc"}], ",", 
         RowBox[{"i", "++"}], ",", 
         RowBox[{"lista", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"lista", ",", 
            RowBox[{"StringJoin", "[", 
             RowBox[{"StringJoin", "[", 
              RowBox[{
               RowBox[{"ToString", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"ndse", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", "i"}], "]"}], "]"}], "[", "x", "]"}], 
                 ",", "InputForm"}], "]"}], ",", "\"\<; \>\""}], "]"}], 
             "]"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"lista", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"lista", ",", "\"\<\\n\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Cabec", "=", 
        RowBox[{"StringJoin", "[", "lista", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"matout", ",", "Cabec"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "xCorte"}], ",", "xCorte", ",", 
        RowBox[{"xCorte", "/", "NumRegArq"}]}], "}"}]}], "]"}], ";"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Close", "[", "matout", "]"}]}], "Input",
