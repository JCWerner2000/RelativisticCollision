   RowBox[{
    RowBox[{"NumRegArq", "=", "500"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xstep", "=", 
     RowBox[{"xmax", "/", "NumRegArq"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PorcCorte", "=", "0.95"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ListaCorte", "=", 
